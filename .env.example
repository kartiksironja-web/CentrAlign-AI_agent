# Copy to .env and edit. .env is git-ignored. Mock credentials only.

# --- mock company app ---
# Folder holding company.db and the portal PDFs (default: ./data)
# COMPANY_DATA_DIR=
PORT=8000
# Faults are all OFF by default. Comma separated, e.g. FAULTS=DATE_TRAP,SAVE_BROKEN
FAULTS=
# /admin/* needs this token in the X-Admin-Token header. Only the runner knows it; the agent never does.
ADMIN_TOKEN=mock-admin-token

# --- the language model: pick ONE provider, set its model id and its key ---
# The provider is the part of AGENT_MODEL before the "/" (LiteLLM model strings).
# Check the provider's own limits page: free tiers differ a lot (Gemini's free key allows only
# 20 requests per day per model, which is less than one agent run of about 25 calls).
#
# Option A: Mistral (free "Experiment" plan reported to need no card, only phone verification; check your Limits page)
# AGENT_MODEL=mistral/mistral-medium-latest
# MISTRAL_API_KEY=
#
# Option B: NVIDIA NIM (free for developers, about 40 requests per minute; pick a model whose card lists tool calling)
# AGENT_MODEL=nvidia_nim/<model id from build.nvidia.com>
# NVIDIA_NIM_API_KEY=
#
# Option C: Google Gemini (key from https://aistudio.google.com/apikey; the free tier is too small for a run)
AGENT_MODEL=gemini/gemini-3.5-flash
GEMINI_API_KEY=

# Leave empty to use the model's own default. Set 0 only for models that accept it
# (it makes runs more repeatable). Gemini 3 models should stay at their default.
AGENT_TEMPERATURE=
# Output limit per model call (thinking models spend part of it on thinking).
# AGENT_MAX_TOKENS=8192
# Retries for rate limits, timeouts and server errors (a daily or monthly quota is never retried).
# AGENT_MAX_RETRIES=3
# Free tiers limit requests per minute: wait at least this many seconds between model calls.
# 6 means at most 10 calls a minute.
AGENT_MIN_INTERVAL_SECONDS=6
# Optional: ask a thinking model to think less (faster, fewer tokens): low | medium | high
# AGENT_REASONING_EFFORT=low
