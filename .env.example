# Copy to .env and edit. .env is git-ignored. Mock credentials only.

# --- mock company app ---
# Folder holding company.db and the portal PDFs (default: ./data)
# COMPANY_DATA_DIR=
PORT=8000
# Faults are all OFF by default. Comma separated, e.g. FAULTS=DATE_TRAP,SAVE_BROKEN
FAULTS=
# /admin/* needs this token in the X-Admin-Token header. Only the runner knows it; the agent never does.
ADMIN_TOKEN=mock-admin-token

# --- the language model: pick ONE provider, set its model id and its key ---
# The provider is the part of AGENT_MODEL before the "/" (LiteLLM model strings). Check your provider's own
# limits page: free plans differ a lot, and one agent run makes about 25 model calls (150k-250k tokens).
#
# Used for every result in this repository: Mistral's free plan, model ministral-14b-latest
# (30 requests and about 900k tokens per minute on the key that was tested). Note: on that key the larger
# mistral-medium-* / mistral-small-* models answered HTTP 429 with a limit of 0, so check what YOUR key can use.
AGENT_MODEL=mistral/ministral-14b-latest
MISTRAL_API_KEY=
#
# Other providers are wired in agent/llm.py (the key variable is checked before anything starts) but were not
# used for any result here:
#   AGENT_MODEL=gemini/gemini-3.5-flash      GEMINI_API_KEY=       (a free key allows only 20 calls per day per model: too few for one run)
#   AGENT_MODEL=nvidia_nim/<model id>        NVIDIA_NIM_API_KEY=
#   AGENT_MODEL=openai/<model id>            OPENAI_API_KEY=

# Leave empty to use the model's own default. Set 0 only for models that accept it
# (it makes runs more repeatable). Results here used the provider's default.
AGENT_TEMPERATURE=
# Output limit per model call (thinking models spend part of it on thinking).
# AGENT_MAX_TOKENS=8192
# Retries for rate limits, timeouts and server errors (a daily or monthly quota is never retried).
# AGENT_MAX_RETRIES=3
# Wait at least this many seconds between model calls (free plans limit requests per minute).
AGENT_MIN_INTERVAL_SECONDS=3
# Optional: ask a thinking model to think less (faster, fewer tokens): low | medium | high
# AGENT_REASONING_EFFORT=low
